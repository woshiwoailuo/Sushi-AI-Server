<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="服务器设置" android:textColor="@color/text" android:textSize="22sp" android:layout_marginTop="40dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="填写后端首页的 HTTPS 地址，不要填 APK 下载链接。临时隧道地址变化后，可在这里更换。" android:textColor="@color/muted" android:layout_marginTop="14dp" />
        <EditText android:id="@+id/url" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:background="@drawable/bg_input" android:padding="14dp" android:layout_marginTop="20dp" android:textColor="@color/text" android:inputType="textUri" android:hint="https://你的服务器域名" android:textColorHint="@color/muted" />
        <Button android:id="@+id/testConnection" android:layout_width="match_parent" android:layout_height="52dp" android:text="检测连接" android:textAllCaps="false" android:textColor="@color/text" android:layout_marginTop="16dp" />
        <TextView android:id="@+id/connectionStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingTop="12dp" android:textColor="@color/text" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="52dp" android:text="保存地址" android:textAllCaps="false" android:background="@drawable/bg_btn" android:textColor="@color/on_accent" android:layout_marginTop="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="更换服务器后需要重新登录。" android:textColor="@color/muted" android:layout_marginTop="10dp" />
        <Button android:id="@+id/backServer" android:layout_width="match_parent" android:layout_height="48dp" android:text="返回" android:textAllCaps="false" android:textColor="@color/text" android:layout_marginTop="14dp" />
    </LinearLayout>
</ScrollView>
