<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="@color/bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="我的" android:textColor="@color/text" android:textSize="22sp" android:layout_marginTop="6dp" android:layout_marginBottom="16dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="18sp" />
        <TextView android:id="@+id/email" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:layout_marginTop="4dp" />
        <TextView android:id="@+id/plan" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" android:layout_marginTop="12dp" />
        <TextView android:id="@+id/quota" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:layout_marginTop="6dp" />
        <TextView android:id="@+id/quotaRemain" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:layout_marginTop="6dp" />
    </LinearLayout>
    <android.widget.Button android:id="@+id/serverBtn" android:layout_width="match_parent" android:layout_height="52dp" android:text="服务器地址（管理员）" android:textColor="@color/on_accent" android:layout_marginTop="20dp" android:visibility="gone" android:clickable="true" android:focusable="true" android:textAllCaps="false" />
    <TextView android:id="@+id/appVer" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginTop="18dp" />
    <LinearLayout android:id="@+id/updateBanner" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_marginTop="10dp" android:visibility="gone">
        <TextView android:id="@+id/updateMsg" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="15sp" />
        <android.widget.Button android:id="@+id/downloadUpdate" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:background="@drawable/bg_btn" android:text="下载更新" android:textAllCaps="false" android:textColor="@color/on_accent" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <android.widget.Button
        android:id="@+id/checkUpdate"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:text="检查更新"
        android:textAllCaps="false"
        android:textColor="@color/text" />
    <android.widget.Button
        android:id="@+id/downloadApk"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:text="下载安装包"
        android:textAllCaps="false"
        android:textColor="@color/text" />
    <android.widget.Button
        android:id="@+id/logout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/logout"
        android:textAllCaps="false"
        android:textColor="@color/danger" />
</LinearLayout>
