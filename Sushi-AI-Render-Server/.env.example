# Copy this file to .env only for a NEW installation. Keep existing production values.
PORT=8787
HOST=0.0.0.0
# Optional absolute path. Default: server/data (contains the membership database).
# DATA_DIR=/absolute/path/to/sushi-data
# Vercel uses /tmp by default, which is not durable.
# Set DATABASE_URL to a Neon/Postgres connection string to enable durable membership storage.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# After DATABASE_URL is live and /api/health shows db.durable=true + provider=postgres,
# you may set SUSHI_DB_PERSISTENCE=external as an operator note (it alone does NOT make durable true).
SUSHI_DB_PERSISTENCE=local

# Set your own values before starting a new installation.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_EMAIL=REPLACE_WITH_YOUR_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_YOUR_ADMIN_PASSWORD

# Optional: anonymous free access is used when empty. No paid key is required.
HORDE_API_KEY=
# Optional: leave empty to let available workers choose a model.
HORDE_MODEL=
PERCHANCE_URL=https://perchance.org/ai-text-to-image-generator

# Required only for sending registration verification emails.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional JSON file with a "pass" field, instead of SMTP_PASS.
SMTP_PASS_FILE=

# Optional: homepage / workshop Grok chat (xAI OpenAI-compatible).
# Prefer XAI_API_KEY; GROK_API_KEY is accepted as an alias.
# XAI_API_KEY=
# GROK_MODEL=grok-4-fast

# Optional free homepage auto-race chat channels (booleans are exposed via GET /api/health.chat).
# Never commit real keys. Set these on Vercel and redeploy.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# GLM_API_KEY=
# GLM_MODEL=glm-4.7-flash
# ZHIPUAI_API_KEY=
# ZAI_API_KEY=
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

